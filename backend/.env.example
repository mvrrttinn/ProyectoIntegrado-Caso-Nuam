# ==============================================================================
# CONFIGURACIÓN GENERAL DEL BACKEND - DJANGO 5.2 / NUAM EXCHANGE GROUP
# ==============================================================================
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=coloca-tu-secret-key-aqui
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# ==============================================================================
# BASE DE DATOS TRANSACCIONAL ACID: POSTGRESQL (SUPABASE POOLER / DIRECT)
# ==============================================================================
# Conexión directa (5432) o vía Connection Pooler Supabase (6543)
# Formato: postgresql://[user]:[password]@[host]:[port]/[db_name]?sslmode=require
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=postgres.[project-ref]
DB_PASSWORD=tu_password_supabase
DB_HOST=aws-0-[region].pooler.supabase.com
DB_PORT=6543
DB_SSLMODE=require

# Switch para fallback a SQLite en entornos locales sin red o ejecución de tests
USE_SQLITE_FOR_TESTS=True

# ==============================================================================
# SUPABASE AUTH / GOTRUE & APIS
# ==============================================================================
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=tu_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key
SUPABASE_JWT_SECRET=tu_supabase_jwt_secret

# ==============================================================================
# AUDITORÍA DOCUMENTAL Y CADENA DE INTEGRIDAD (MONGODB ATLAS)
# ==============================================================================
MONGO_URI=mongodb+srv://[usuario]:[password]@[cluster].mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=nuam_audit
MONGO_COLLECTION_AUDIT=audit_logs

# ==============================================================================
# CORS & FRONTEND CLIENT
# ==============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
