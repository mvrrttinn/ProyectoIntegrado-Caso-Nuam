# ==========================================
# CONFIGURACIÓN GENERAL DEL PROYECTO
# ==========================================
ENVIRONMENT=development
DEBUG=True
SECRET_KEY= # Generar una clave secreta segura para el entorno local
ALLOWED_HOSTS=localhost,127.0.0.1

# ==========================================
# SUPABASE (POSTGRESQL & AUTH)
# ==========================================
SUPABASE_URL= # URL proporcionada por el panel de Supabase
SUPABASE_ANON_KEY= # Clave pública anónima
SUPABASE_JWT_SECRET= # Necesario para la validación de firmas JWT en el backend
DATABASE_URL= # Cadena de conexión PostgreSQL (Pooling)

# ==========================================
# MONGODB ATLAS (AUDITORÍA)
# ==========================================
MONGO_URI= # Cadena de conexión a MongoDB Atlas
MONGO_DB_NAME=nuam_audit

# ==========================================
# FRONTEND VITE/REACT
# ==========================================
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_SUPABASE_URL= # URL pública para el cliente web
VITE_SUPABASE_ANON_KEY= # Clave pública para el cliente web